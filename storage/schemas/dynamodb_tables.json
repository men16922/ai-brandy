{
  "regions": {
    "table_name_template": "brandy-regions-{environment}",
    "key_schema": [
      {"AttributeName": "PK", "KeyType": "HASH"},
      {"AttributeName": "SK", "KeyType": "RANGE"}
    ],
    "attribute_definitions": [
      {"AttributeName": "PK", "AttributeType": "S"},
      {"AttributeName": "SK", "AttributeType": "S"}
    ],
    "billing_mode": "PAY_PER_REQUEST",
    "description": "지역 및 구역별 특성 데이터 저장"
  },
  "business_types": {
    "table_name_template": "brandy-business-types-{environment}",
    "key_schema": [
      {"AttributeName": "PK", "KeyType": "HASH"},
      {"AttributeName": "SK", "KeyType": "RANGE"}
    ],
    "attribute_definitions": [
      {"AttributeName": "PK", "AttributeType": "S"},
      {"AttributeName": "SK", "AttributeType": "S"}
    ],
    "billing_mode": "PAY_PER_REQUEST",
    "description": "업종별 키워드 및 스타일 제안 데이터"
  },
  "workflow": {
    "table_name_template": "brandy-workflow-{environment}",
    "key_schema": [
      {"AttributeName": "PK", "KeyType": "HASH"},
      {"AttributeName": "SK", "KeyType": "RANGE"}
    ],
    "attribute_definitions": [
      {"AttributeName": "PK", "AttributeType": "S"},
      {"AttributeName": "SK", "AttributeType": "S"},
      {"AttributeName": "GSI1PK", "AttributeType": "S"},
      {"AttributeName": "GSI1SK", "AttributeType": "S"}
    ],
    "global_secondary_indexes": [
      {
        "IndexName": "GSI1",
        "KeySchema": [
          {"AttributeName": "GSI1PK", "KeyType": "HASH"},
          {"AttributeName": "GSI1SK", "KeyType": "RANGE"}
        ],
        "Projection": {"ProjectionType": "ALL"}
      }
    ],
    "billing_mode": "PAY_PER_REQUEST",
    "ttl_attribute": "expire_at",
    "description": "워크플로 세션 및 채팅 이력 저장"
  }
}